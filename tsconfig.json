{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "outDir": "dist",
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "removeComments": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "strict": true,
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types/",
      "**/types/**/*.d.ts"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["vite/client"]
  },
  "exclude": [
    "**/node_modules",
    "**/__tests__"
  ]
}
